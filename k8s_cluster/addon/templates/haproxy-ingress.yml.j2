apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    helm.sh/chart: haproxy-ingress-0.15.1
    app.kubernetes.io/name: haproxy-ingress-default-backend
    app.kubernetes.io/instance: haproxy-ingress
    app.kubernetes.io/version: "v0.15.1"
    app.kubernetes.io/managed-by: Helm
  name: haproxy-ingress-default-backend
  namespace: kube-system
spec:
  replicas: 3
  selector:
    matchLabels:
      app.kubernetes.io/name: haproxy-ingress-default-backend
      app.kubernetes.io/instance: haproxy-ingress
  template:
    metadata:
      labels:
        app.kubernetes.io/name: haproxy-ingress-default-backend
        app.kubernetes.io/instance: haproxy-ingress
    spec:
      containers:
        - name: default-backend
          image: "registry.k8s.io/defaultbackend-amd64:1.5"
          imagePullPolicy: "IfNotPresent"
          livenessProbe:
            failureThreshold: 3
            httpGet:
              path: /healthz
              port: http
              scheme: HTTP
            initialDelaySeconds: 10
            periodSeconds: 10
            successThreshold: 1
            timeoutSeconds: 1
          ports:
            - name: http
              containerPort: 8080
              protocol: TCP
          resources:
            limits:
              cpu: 10m
              memory: 20Mi
          readinessProbe:
            failureThreshold: 3
            httpGet:
              path: /healthz
              port: http
              scheme: HTTP
            initialDelaySeconds: 10
            periodSeconds: 10
            successThreshold: 1
            timeoutSeconds: 1
      serviceAccountName: haproxy-ingress-default-backend
      terminationGracePeriodSeconds: 60
      securityContext:
        runAsNonRoot: true
        runAsUser: 65000
        runAsGroup: 65000
        fsGroup: 65000
