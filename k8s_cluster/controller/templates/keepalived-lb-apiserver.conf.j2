
global_defs {
  script_user root
  enable_script_security
  vrrp_version 3
  lvs_flush
  max_auto_priority

  fifo_write_vrrp_states_on_reload

  # Using a fifo allows more efficient processing of notify events, and guarantees that they will be delivered in the correct sequence.
  vrrp_notify_fifo "/run/keepalived/vrrp_notify.fifo"
  vrrp_notify_fifo_script "/etc/keepalived/keepalived-bypass-ipvs.sh"
}

vrrp_instance VI_1 {
  state BACKUP
  interface {{ ansible_facts.default_ipv4.interface }}
  virtual_router_id 55
  priority 100
  advert_int 1

  track_interface {
    {{ ansible_facts.default_ipv4.interface }}
  }

  unicast_src_ip {{ ansible_facts.default_ipv4.address }}
  unicast_peer {
    {% for peer in apiserver_keepalived_peers | sort() -%}
    {{ peer }}
    {% endfor -%}
  }

  virtual_ipaddress {
    {{ apiserver.keepalived.vip_cidr }}
  }

  # Not interested in priorty changes
  notify_priority_changes  false

  # All servers are same priority, so no need to preempt
  nopreempt
}

{% if apiserver.lb_ha_mgr is defined  and  apiserver.lb_ha_mgr == "keepalived_ipvs" %}
virtual_server {{ apiserver.keepalived.vip_cidr | ansible.utils.ipaddr('address') }} {{ apiserver.secure_port }} {
  delay_loop 5
  lvs_sched rr
  lvs_method DR
  protocol TCP

  {% for real_server in apiserver_keepalived_real_servers | sort() -%}
  real_server {{ real_server }} {{ apiserver.secure_port }} {
    weight 1
    TCP_CHECK {
      connect_port {{ apiserver.secure_port }}
      connect_timeout 3
    }
  }
  {% endfor %}
}
{% endif %}
