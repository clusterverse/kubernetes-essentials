[Unit]
Description=Keepalived VRRP FIFO Reader and Bypass Rules
After=keepalived.service
BindsTo=keepalived.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /run/keepalived
ExecStartPre=/bin/bash -c 'test -p /run/keepalived/vrrp_notify.fifo || mkfifo /run/keepalived/vrrp_notify.fifo'
ExecStart=/etc/keepalived/keepalived-bypass-ipvs.sh
Restart=on-failure
RestartSec=3

# Increase logging level if needed
Environment="SYSTEMD_LOG_LEVEL=info"

[Install]
WantedBy=multi-user.target